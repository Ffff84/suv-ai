# Скопируйте в .env и заполните. .env уже в .gitignore — в git не попадёт.
TELEGRAM_TOKEN=
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=
FIELD_LAT=39.6547
FIELD_LON=66.9597
# Кому разрешено пользоваться ботом (chat_id через запятую).
# Пусто = открыт всем: годится для демо, не годится для пилота.
ALLOWED_CHAT_IDS=
# Закрытое демо экрана «Dala holati» (chat_id через запятую).
# Пусто = экрана ни у кого нет, бот работает ровно как раньше.
FIELD_STATUS_CHAT_IDS=
# HTTPS-адрес страницы обводки поля (miniapp/draw.html), например
# https://suv-ai.uz/draw. Пусто = кнопки карты нет, контур собирается
# обходом углов с геолокацией. Telegram не открывает веб-вид по http.
MINIAPP_URL=
# Запасной источник снимков: Landsat 8/9 через Microsoft Planetary
# Computer. Включается ТОЛЬКО когда Sentinel-2 не дал годного кадра —
# за прошлый год это 21 дата, которую движок иначе отработал бы вслепую
# по календарю. Ключей не требует (доступ анонимный), квоту Copernicus
# не тратит. Пусто = выключено, поведение бота ровно как раньше.
# Включён с 09.09.2026: по саду Olmazor второй источник поднимает
# плотность наблюдений примерно на 40% (S2 49 годных кадров, Landsat 29,
# вместе 69). Худший провал в 30 дней подряд он не лечит — это надо
# говорить вслух, а не прятать за цифрой прироста.
LANDSAT_FALLBACK=1
# Наблюдатель: видит /suv и /tejaldi по ВСЕМ полям и по-русски, но в
# журнал KPI не пишет и полив не отмечает — «полил тот, кто полил».
# Для агронома хозяйства и для показа жюри.
OBSERVER_CHAT_IDS=
# Веб-кабинет: подробный разбор поля на большом экране. Нужны ОБА —
# список чатов и HTTPS-адрес страницы (landing/dala/index.html).
# Вход по подписи Telegram, паролей нет (suv/webauth.py).
CABINET_CHAT_IDS=
CABINET_URL=
# Куда пересылать вопросы фермеров, написанные боту свободным текстом
# (chat_id Амира). Пусто = фермер всё равно получает ответ «вопрос
# принят», сообщение остаётся в логе, но никому не уезжает.
ADMIN_CHAT_IDS=
# Файл журнала. По умолчанию suv.db в рабочем каталоге службы.
# Этот файл — единственный носитель KPI и акта экономии: бэкап
# обязателен, см. ДЕПЛОЙ.md.
SUV_DB=
